@tool
class_name CubePreview
extends Node3D
## Кубик-превью: тип выбирается в Инспекторе, визуал строится кодом.
## Работает и в редакторе, и в рантайме. Без внешних ассетов.

enum CubeType { MONITOR, DIGIT, LOGIC, COMPARE, DO, BUTTON }

# ---------- Палитра ----------
const WOOD_LIGHT := Color("a06a3a")
const WOOD_MID   := Color("8b5a2b")
const WOOD_DARK  := Color("5a3a1a")
const SCREEN_BG  := Color("0a1a0a")
const GREEN_GLOW := Color("00ff00")

# ---------- Экспорт ----------
@export var cube_type: CubeType = CubeType.DIGIT:
	set(v):
		if cube_type == v: return
		cube_type = v
		sub_value = clampi(sub_value, 0, _max_value())
		_request_rebuild()

@export_range(0, 9) var sub_value: int = 0:
	set(v):
		var c := clampi(v, 0, _max_value())
		if sub_value == c: return
		sub_value = c
		_request_rebuild()

@export var animate: bool = true
@export var in_automaton: bool = true      # для монитора: номер или «снег»

# ---------- Состояние ----------
var _anim_time: float = 0.0
var _noise_accum: float = 0.0
var _rebuild_queued: bool = false

# Ссылки на узлы, которые нужно анимировать
var _screen_mat: StandardMaterial3D = null
var _screen_label: Label3D = null
var _logic_quad: MeshInstance3D = null
var _logic_mat: StandardMaterial3D = null
var _compare_sticks: Array[MeshInstance3D] = []
var _arrow_root: Node3D = null
var _button_panel_mat: StandardMaterial3D = null
var _digit_label: Label3D = null

# ============================================================
# Lifecycle
# ============================================================

func _ready() -> void:
	_rebuild()

func _process(delta: float) -> void:
	if not animate:
		return
	_anim_time += delta
	_tick_animation()

func _request_rebuild() -> void:
	if _rebuild_queued: return
	_rebuild_queued = true
	call_deferred("_do_rebuild")

func _do_rebuild() -> void:
	_rebuild_queued = false
	_rebuild()

func _max_value() -> int:
	match cube_type:
		CubeType.MONITOR: return 7    # отображается как 1..8
		CubeType.DIGIT:   return 9
		CubeType.LOGIC:   return 3
		CubeType.COMPARE: return 2
		CubeType.DO:      return 0
		CubeType.BUTTON:  return 5
	return 9

# ============================================================
# Rebuild
# ============================================================

func _rebuild() -> void:
	# Очистка
	for child in get_children():
		remove_child(child)
		child.queue_free()

	_screen_mat = null
	_screen_label = null
	_logic_quad = null
	_logic_mat = null
	_compare_sticks.clear()
	_arrow_root = null
	_button_panel_mat = null
	_digit_label = null

	match cube_type:
		CubeType.MONITOR: _build_monitor()
		CubeType.DIGIT:   _build_digit()
		CubeType.LOGIC:   _build_logic()
		CubeType.COMPARE: _build_compare()
		CubeType.DO:      _build_do()
		CubeType.BUTTON:  _build_button()

# ============================================================
# Билдеры — по одному на каждый тип
# ============================================================

# --- МОНИТОР: выпуклый старый телевизор -----------------------

func _build_monitor() -> void:
	# Корпус
	add_child(_make_box(Vector3(0.5, 0.42, 0.42), WOOD_MID, Vector3.ZERO))

	# Передняя панель
	add_child(_make_box(Vector3(0.46, 0.38, 0.03), WOOD_LIGHT, Vector3(0, 0.02, 0.21)))

	# Экран
	var screen := MeshInstance3D.new()
	var qm := QuadMesh.new()
	qm.size = Vector2(0.26, 0.20)
	screen.mesh = qm
	screen.position = Vector3(-0.04, 0.02, 0.225)
	_screen_mat = StandardMaterial3D.new()
	_screen_mat.albedo_color = SCREEN_BG
	_screen_mat.emission_enabled = true
	_screen_mat.emission = GREEN_GLOW * 0.3
	_screen_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	screen.material_override = _screen_mat
	add_child(screen)

	# Метка (номер монитора)
	_screen_label = Label3D.new()
	_screen_label.text = str(sub_value + 1)
	_screen_label.font_size = 160
	_screen_label.pixel_size = 0.0013
	_screen_label.position = Vector3(-0.04, 0.02, 0.228)
	_screen_label.modulate = GREEN_GLOW
	_screen_label.outline_size = 10
	_screen_label.outline_modulate = Color.BLACK
	_screen_label.visible = in_automaton
	add_child(_screen_label)

	# Антенны
	var a1 := _make_cylinder(0.008, 0.2, WOOD_DARK, Vector3(-0.1, 0.32, 0))
	a1.rotation_degrees = Vector3(0, 0, -20)
	add_child(a1)
	var a2 := _make_cylinder(0.008, 0.2, WOOD_DARK, Vector3(0.1, 0.32, 0))
	a2.rotation_degrees = Vector3(0, 0, 20)
	add_child(a2)
	add_child(_make_sphere(0.022, WOOD_DARK, Vector3(-0.17, 0.41, 0)))
	add_child(_make_sphere(0.022, WOOD_DARK, Vector3( 0.17, 0.41, 0)))

	# Крутилки справа
	for y in [0.10, -0.05, -0.20]:
		var k := _make_cylinder(0.028, 0.02, WOOD_DARK, Vector3(0.19, y, 0.22))
		k.rotation_degrees = Vector3(90, 0, 0)
		add_child(k)

	# Ножки
	for x in [-0.18, 0.18]:
		for z in [-0.14, 0.14]:
			add_child(_make_box(Vector3(0.05, 0.06, 0.05), WOOD_DARK, Vector3(x, -0.24, z)))

# --- ЦИФРА: кубик со «выжженной» цифрой -----------------------

func _build_digit() -> void:
	add_child(_make_box(Vector3(0.4, 0.4, 0.4), WOOD_MID, Vector3.ZERO))
	# Углубление на передней грани
	add_child(_make_box(Vector3(0.34, 0.34, 0.015), WOOD_DARK, Vector3(0, 0, 0.20)))

	_digit_label = Label3D.new()
	_digit_label.text = str(sub_value)
	_digit_label.font_size = 340
	_digit_label.pixel_size = 0.0015
	_digit_label.position = Vector3(0, 0, 0.22)
	_digit_label.modulate = Color(0.15, 0.08, 0.0)   # как выжженная
	_digit_label.outline_size = 0
	add_child(_digit_label)

# --- ЛОГИКА: доска с диаграммой Венна -------------------------

func _build_logic() -> void:
	add_child(_make_box(Vector3(0.4, 0.4, 0.4), WOOD_MID, Vector3.ZERO))
	add_child(_make_box(Vector3(0.34, 0.34, 0.015), Color("1a2a1a"), Vector3(0, 0, 0.20)))

	_logic_quad = MeshInstance3D.new()
	var qm := QuadMesh.new()
	qm.size = Vector2(0.3, 0.3)
	_logic_quad.mesh = qm
	_logic_quad.position = Vector3(0, 0, 0.21)
	_logic_mat = StandardMaterial3D.new()
	_logic_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	_logic_mat.albedo_texture = _make_venn_texture(sub_value)
	_logic_quad.material_override = _logic_mat
	add_child(_logic_quad)

# --- СРАВНЕНИЕ: две палочки ----------------------------------

func _build_compare() -> void:
	add_child(_make_box(Vector3(0.4, 0.4, 0.4), WOOD_MID, Vector3.ZERO))

	var a := _make_box(Vector3(0.045, 0.24, 0.02), WOOD_DARK, Vector3.ZERO)
	var b := _make_box(Vector3(0.045, 0.24, 0.02), WOOD_DARK, Vector3.ZERO)
	add_child(a)
	add_child(b)
	_compare_sticks.append(a)
	_compare_sticks.append(b)
	_apply_compare_pose()

# --- DO: стрелка -------------------------------------------

func _build_do() -> void:
	add_child(_make_box(Vector3(0.4, 0.4, 0.4), WOOD_MID, Vector3.ZERO))
	add_child(_make_box(Vector3(0.34, 0.34, 0.015), WOOD_DARK, Vector3(0, 0, 0.20)))

	_arrow_root = Node3D.new()
	add_child(_arrow_root)

	var col := Color("f0c060")
	# Хвостовик
	_arrow_root.add_child(_make_box(Vector3(0.20, 0.04, 0.02), col, Vector3(-0.05, 0, 0.22)))
	# Наконечник
	var h1 := _make_box(Vector3(0.11, 0.035, 0.02), col, Vector3(0.09,  0.04, 0.22))
	h1.rotation = Vector3(0, 0, deg_to_rad(-45))
	_arrow_root.add_child(h1)
	var h2 := _make_box(Vector3(0.11, 0.035, 0.02), col, Vector3(0.09, -0.04, 0.22))
	h2.rotation = Vector3(0, 0, deg_to_rad(45))
	_arrow_root.add_child(h2)

# --- КНОПКА: цветная панель --------------------------------

func _build_button() -> void:
	add_child(_make_box(Vector3(0.4, 0.4, 0.4), WOOD_MID, Vector3.ZERO))

	var panel := _make_box(Vector3(0.32, 0.32, 0.02), _button_color(sub_value), Vector3(0, 0, 0.205))
	_button_panel_mat = StandardMaterial3D.new()
	_button_panel_mat.albedo_color = _button_color(sub_value)
	_button_panel_mat.emission_enabled = true
	_button_panel_mat.emission = _button_color(sub_value) * 0.4
	_button_panel_mat.roughness = 0.3
	panel.material_override = _button_panel_mat
	add_child(panel)

# ============================================================
# Анимации (и в редакторе, и в игре)
# ============================================================

func _tick_animation() -> void:
	match cube_type:
		CubeType.MONITOR: _anim_monitor()
		CubeType.LOGIC:   _anim_logic()
		CubeType.COMPARE: _anim_compare()
		CubeType.DO:      _anim_do()
		CubeType.BUTTON:  _anim_button()
		_: pass

func _anim_monitor() -> void:
	# Мерцание экрана + дрожание цифры. Вне автомата — «снег».
	if in_automaton:
		if _screen_mat:
			var base: float = 0.25 + 0.08 * sin(_anim_time * 11.0) * sin(_anim_time * 3.7)
			_screen_mat.emission = GREEN_GLOW * base
		if _screen_label:
			_screen_label.position.y = 0.02 + 0.004 * sin(_anim_time * 37.0)
			_screen_label.modulate = GREEN_GLOW * (0.85 + 0.15 * sin(_anim_time * 8.0))
	else:
		# «Снег» — меняем яркость каждый ~50 мс
		_noise_accum += get_process_delta_time()
		if _noise_accum > 0.05:
			_noise_accum = 0.0
			if _screen_mat:
				var v := randf()
				_screen_mat.emission = GREEN_GLOW * (0.15 + 0.55 * v)

func _anim_logic() -> void:
	if _logic_quad:
		_logic_quad.scale = Vector3.ONE * (1.0 + 0.02 * sin(_anim_time * 3.0))

func _anim_compare() -> void:
	# Палочки «дышат», будто плохо закреплены
	for s in _compare_sticks:
		s.scale = Vector3.ONE * (1.0 + 0.02 * sin(_anim_time * 2.4))

func _anim_do() -> void:
	if _arrow_root:
		var k: float = 1.0 + 0.06 * sin(_anim_time * 4.0)
		_arrow_root.scale = Vector3(k, k, 1.0)

func _anim_button() -> void:
	if _button_panel_mat:
		var base: Color = _button_color(sub_value)
		var pulse: float = 0.5 + 0.5 * (0.5 + 0.5 * sin(_anim_time * 3.0))
		_button_panel_mat.emission = base * (0.25 + 0.55 * pulse)

# ============================================================
# Публичное взаимодействие (для превью-клика)
# ============================================================

func interact() -> void:
	var mx := _max_value()
	if mx <= 0: return
	sub_value = (sub_value + 1) % (mx + 1)

	# Небольшой "переворот" — ощущение физического кубика
	var tw := create_tween()
	tw.tween_property(self, "rotation:y", rotation.y + PI, 0.3).set_trans(Tween.TRANS_CUBIC)

# ============================================================
# Помощники: меши
# ============================================================

func _make_box(size: Vector3, color: Color, pos: Vector3) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var bm := BoxMesh.new()
	bm.size = size
	mi.mesh = bm
	mi.position = pos
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.85
	mi.material_override = mat
	return mi

func _make_cylinder(radius: float, height: float, color: Color, pos: Vector3) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var cm := CylinderMesh.new()
	cm.top_radius = radius
	cm.bottom_radius = radius
	cm.height = height
	mi.mesh = cm
	mi.position = pos
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.85
	mi.material_override = mat
	return mi

func _make_sphere(radius: float, color: Color, pos: Vector3) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	var sm := SphereMesh.new()
	sm.radius = radius
	sm.height = radius * 2
	mi.mesh = sm
	mi.position = pos
	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.roughness = 0.85
	mi.material_override = mat
	return mi

# ============================================================
# Помощники: логика
# ============================================================

func _apply_compare_pose() -> void:
	if _compare_sticks.size() < 2: return
	var a := _compare_sticks[0]
	var b := _compare_sticks[1]
	match sub_value:
		0:  # >
			a.position = Vector3(0,  0.06, 0.21)
			a.rotation = Vector3(0, 0, deg_to_rad(-40))
			b.position = Vector3(0, -0.06, 0.21)
			b.rotation = Vector3(0, 0, deg_to_rad( 40))
		1:  # <
			a.position = Vector3(0,  0.06, 0.21)
			a.rotation = Vector3(0, 0, deg_to_rad( 40))
			b.position = Vector3(0, -0.06, 0.21)
			b.rotation = Vector3(0, 0, deg_to_rad(-40))
		2:  # =
			a.position = Vector3(0,  0.06, 0.21)
			a.rotation = Vector3(0, 0, deg_to_rad(90))
			b.position = Vector3(0, -0.06, 0.21)
			b.rotation = Vector3(0, 0, deg_to_rad(90))

func _button_color(i: int) -> Color:
	match i:
		0: return Color("00ff00")   # GREEN
		1: return Color("ff2020")   # RED
		2: return Color("2060ff")   # BLUE
		3: return Color("ffff00")   # YELLOW
		4: return Color("b040ff")   # PURPLE
		5: return Color("ff8000")   # ORANGE
	return Color.WHITE

func _make_venn_texture(mode: int) -> ImageTexture:
	# Рисуем диаграмму Венна прямо в Image — 128×128
	var s := 128
	var img := Image.create(s, s, false, Image.FORMAT_RGBA8)
	img.fill(Color(0.06, 0.12, 0.08))   # доска

	var c1 := Vector2(s * 0.40, s * 0.5)
	var c2 := Vector2(s * 0.60, s * 0.5)
	var r := s * 0.22
	var fill_col := Color(0.30, 1.00, 0.40)
	var edge_col := Color(0.75, 1.00, 0.80)

	for y in s:
		for x in s:
			var p := Vector2(x, y)
			var in1 := p.distance_to(c1) < r
			var in2 := p.distance_to(c2) < r
			var fill := false
			match mode:
				0: fill = in1 and in2       # AND
				1: fill = in1 or  in2       # OR
				2: fill = in1 !=  in2       # XOR
				3: fill = in1               # NOT — только левый
			if fill:
				img.set_pixel(x, y, fill_col)

	# Обводки кругов
	for y in s:
		for x in s:
			var p := Vector2(x, y)
			var e1: float = abs(p.distance_to(c1) - r)
			var e2: float = abs(p.distance_to(c2) - r)
			if e1 < 1.2 or e2 < 1.2:
				img.set_pixel(x, y, edge_col)

	return ImageTexture.create_from_image(img)
