func drag(delta):
	if not player:
		player = ROOM.Player
		return
	var marker = player.marker
	if look_me:
		for n in ["y", "z"]:
			global_rotation[n] += (marker.global_rotation[n] - global_rotation[n]) * 8 * delta 
	#global_rotation.z += (marker.z - global_rotation.z) * 8 * delta 
	global_position += (marker.global_position + player.velocity/8 - global_position) * 8 * delta 
