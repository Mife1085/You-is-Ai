extends RigidBody3D

#enum Type { MONITOR, DIGIT, LOGIC, COMPARE, DO, BUTTON }

#@export var type: Type = Type.DIGIT
#@export var value: int = 0
@onready var ROOM = get_tree().current_scene
@onready var player: CharacterBody3D = null
@onready var automate: StaticBody3D = null
var busy_pos: Vector2i = Vector2i(-1, -1)
var in_automate: bool = false
var is_drag: bool = false
var look_me: bool = true


func _physics_process(delta: float) -> void:
	if is_drag:
		drag(delta)
		
func start() -> void:
	add_to_group("Cube", true)
	if ROOM is Node3D:
		player = ROOM.Player
		automate = ROOM.Automate
	freeze_mode = FREEZE_MODE_KINEMATIC

func interact(is_pressed: bool = false) -> void:
	is_drag = is_pressed
	freeze = is_pressed
	if not is_pressed:
		automate.snap(self)
		if not in_automate:
			set_thread_safe("angular_velocity", Vector3.ONE*2)
			return


